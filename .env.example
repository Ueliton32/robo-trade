# ── Banco de dados ──────────────────────────────────────────────────────
# Aponta para o Postgres do docker-compose.yml (serviço "postgres").
# Se for usar seu próprio Postgres (fora do Docker Compose), troque a URL.
DATABASE_URL='postgresql://robotrade:robotrade@localhost:5432/robotrade'

# ── Autenticação (NextAuth) ─────────────────────────────────────────────
# OBRIGATÓRIO gerar um valor único e secreto — nunca reaproveite o exemplo
# abaixo nem copie de outro projeto. Qualquer pessoa que souber esse valor
# consegue forjar sessões de login válidas no seu app. Gere o seu com:
#   openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-um-valor-unico-gerado-com-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── E-mail (SMTP) — opcional, só necessário para alertas por e-mail ─────
# Deixe em branco para desativar o envio de e-mail (o app funciona normal,
# só não manda alerta por e-mail; os sinais continuam aparecendo no app).
# Exemplos: SMTP do Gmail (com "senha de app"), Resend, Mailtrap, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Robô Trade <noreply@seudominio.com>"

# ── Agendador em background ─────────────────────────────────────────────
# De quantos em quantos minutos o robô roda sozinho (fecha sinais e gera
# novos), sem precisar de ninguém com o app aberto.
SCHEDULER_INTERVAL_MINUTES=15

# ── Monitoramento do agendador (opcional, mas recomendado) ──────────────
# "Dead man's switch": se configurado, o agendador faz um ping HTTP nessa
# URL a cada ciclo (sucesso ou falha). Crie um monitor gratuito em
# https://healthchecks.io (ou serviço equivalente) esperando um ping a
# cada SCHEDULER_INTERVAL_MINUTES minutos — se o ping parar de chegar
# (processo caiu, servidor caiu, etc.), o PRÓPRIO SERVIÇO externo te avisa
# por e-mail/SMS, porque nesse cenário nada dentro do próprio agendador
# teria como se auto-alertar.
HEALTHCHECK_PING_URL=

# ── Ciclo sem servidor próprio (opcional) ────────────────────────────────
# Alternativa ao scheduler.ts rodando como processo contínuo: publique o
# app (ex: Vercel, grátis) e deixe um GitHub Actions agendado chamar
# GET /api/cron/run-cycle a cada 15 min — sem precisar de VPS nem processo
# seu ligado 24/7. Ver .github/workflows/scheduler-cycle.yml.
# OBRIGATÓRIO gerar um valor único — a rota só aceita a chamada se o header
# Authorization: Bearer <esse valor> bater exatamente. Gere o seu com:
#   openssl rand -base64 32
# Configure o MESMO valor aqui, nas env vars do seu deploy (Vercel etc.) e
# como secret CRON_SECRET no GitHub (Settings → Secrets and variables →
# Actions) do repositório.
CRON_SECRET=troque-por-um-valor-unico-gerado-com-openssl-rand-base64-32
